{
  "name": "my-astro-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "wrangler types && astro check",
    "build": "astro build",
    "postbuild": "bash scripts/check-bundle-size.sh",
    "preview": "astro build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "astro check && eslint src/ --ext .ts,.tsx,.astro",
    "format": "prettier --write 'src/**/*.{ts,tsx,astro,css}'",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "audit:deps": "bash scripts/audit-deps.sh",
    "health:check": "bash scripts/health-report.sh",
    "maintenance:month": "bash scripts/maintenance-month.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "astro": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.0.0",
    "npm-check-updates": "^17.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
